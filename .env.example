PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tandoor_rf_test
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tandoor_rf_test
PGSSLMODE=disable
TRUSTED_PROXIES=

# 1C exchange plain FTP probe (disabled by default; enable only after PR review and TW env approval)
# Login, password, and file data are transmitted without encryption (ONEC_FTP_SECURITY=plain).
ONEC_FTP_ENABLED=false
ONEC_FTP_SECURITY=plain
ONEC_FTP_HOST=ftp.example.com
ONEC_FTP_PORT=21
ONEC_FTP_USER=exchange-user
ONEC_FTP_PASSWORD=
ONEC_FTP_BASE_PATH=/LC
ONEC_FTP_TIMEOUT_MS=15000

# Bitrix24 read-only module (disabled by default; webhook URL must stay in server secrets only)
BITRIX24_ENABLED=false
BITRIX24_WEBHOOK_URL=
BITRIX24_PORTAL_HOST=
BITRIX24_REQUEST_TIMEOUT_MS=15000
BITRIX24_MAX_RESPONSE_BYTES=1048576
BITRIX24_MAX_PAGES=20
BITRIX24_MAX_TOTAL_DURATION_MS=60000
# R2.2 task cache (disabled until production policy is approved)
BITRIX24_CACHE_PUBLISH_ENABLED=false
BITRIX24_CACHE_ACCESS_TTL_MS=0
BITRIX24_TASKS_MODE=pilot
BITRIX24_PILOT_TASK_IDS=
BITRIX24_PILOT_ALLOWLIST_REQUIRED=true
BITRIX24_LINK_VERIFICATION_TTL_MS=86400000
BITRIX24_WORKING_MAX_TASKS_PER_SYNC=20
BITRIX24_WORKING_MAX_DISCOVERY_PAGES=5
BITRIX24_PORTAL_PUBLIC_URL=
BITRIX24_MANUAL_SYNC_MIN_INTERVAL_MS=30000

# Tanbot Telegram (@TANDOOR_IBOT) — server-only secrets; disabled by default (no startup network calls)
TANBOT_TELEGRAM_ENABLED=false
TANBOT_TELEGRAM_BOT_TOKEN=
TANBOT_TELEGRAM_EXPECTED_USERNAME=TANDOOR_IBOT
TANBOT_TELEGRAM_REQUEST_TIMEOUT_MS=15000
TANBOT_TELEGRAM_MAX_RESPONSE_BYTES=65536

# Tanbot MAX — server-only secrets; disabled by default (no webhook registration in this stage)
TANBOT_MAX_ENABLED=false
TANBOT_MAX_BOT_TOKEN=
TANBOT_MAX_EXPECTED_USERNAME=id231100522180_bot
TANBOT_MAX_BOT_USERNAME=id231100522180_bot
TANBOT_MAX_REQUEST_TIMEOUT_MS=15000
TANBOT_MAX_MAX_RESPONSE_BYTES=65536
# Official MinDigital / Russian trusted CA PEM bundle path (see docs/delivery/tanbot-max-stage1-runbook.md)
TANBOT_MAX_TLS_CA_BUNDLE=
TANBOT_MAX_LINK_TOKEN_PEPPER=
TANBOT_MAX_LINK_TOKEN_TTL_MINUTES=15
TANBOT_MAX_WEBHOOK_ENABLED=false
TANBOT_MAX_WEBHOOK_SECRET=
TANBOT_MAX_DELIVERY_ENABLED=false
TANBOT_MAX_OUTBOX_WORKER_ENABLED=false
TANBOT_MAX_OUTBOX_INTERVAL_MS=15000

{
  "name": "tandoor-rf",
  "version": "0.2.0",
  "description": "Tandoor personal account on Timeweb Cloud",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/copy-static.mjs",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env dist/server.js",
    "migrate": "node dist/cli/migrate.js",
    "migrate:local": "node --env-file=.env dist/cli/migrate.js",
    "bootstrap-admin": "node dist/cli/bootstrap-admin.js",
    "bootstrap-admin:local": "node --env-file=.env dist/cli/bootstrap-admin.js",
    "onec-ftp-probe": "node dist/cli/onec-ftp-probe.js",
    "onec-ftp-probe:local": "node --env-file=.env dist/cli/onec-ftp-probe.js",
    "onec-clients-import": "node dist/cli/onec-clients-import.js",
    "onec-clients-import:local": "node --env-file=.env dist/cli/onec-clients-import.js",
    "onec-import-job-worker": "node dist/cli/onec-import-job-worker.js",
    "onec-import-job-worker:local": "node --env-file=.env dist/cli/onec-import-job-worker.js",
    "onec-scheduled-exchange": "node dist/cli/onec-scheduled-exchange.js",
    "onec-scheduled-exchange:local": "node --env-file=.env dist/cli/onec-scheduled-exchange.js",
    "onec-catalog-import": "node dist/cli/onec-catalog-import.js",
    "onec-catalog-import:local": "node --env-file=.env dist/cli/onec-catalog-import.js",
    "bitrix24-probe": "node dist/cli/bitrix24-probe.js",
    "bitrix24-probe:local": "node --env-file=.env dist/cli/bitrix24-probe.js",
    "bitrix24-sync": "node dist/cli/bitrix24-sync.js",
    "bitrix24-sync:local": "node --env-file=.env dist/cli/bitrix24-sync.js",
    "bitrix24-diagnostics": "node dist/cli/bitrix24-diagnostics.js",
    "bitrix24-diagnostics:local": "node --env-file=.env dist/cli/bitrix24-diagnostics.js",
    "bitrix24-labels-bootstrap": "node dist/cli/bitrix24-labels-bootstrap.js",
    "bitrix24-labels-bootstrap:local": "node --env-file=.env dist/cli/bitrix24-labels-bootstrap.js",
    "test": "node --import tsx --test test/server.test.ts test/unit/**/*.test.ts",
    "test:browser": "node --import tsx --test --test-concurrency=1 test/browser/**/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 test/integration/**/*.test.ts",
    "test:all": "npm test && npm run test:browser && npm run test:integration"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "basic-ftp": "^5.3.1",
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "ipaddr.js": "^2.2.0",
    "pg": "^8.13.1",
    "sax": "^1.6.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/sax": "^1.2.7",
    "@types/supertest": "^6.0.2",
    "jsdom": "^29.1.1",
    "node-pty": "^1.1.0",
    "playwright": "^1.49.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

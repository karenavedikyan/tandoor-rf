{
  "name": "tandoor-rf",
  "version": "0.1.0",
  "description": "Timeweb Cloud smoke test for tandoor-rf personal account",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && cp -r public dist/public",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

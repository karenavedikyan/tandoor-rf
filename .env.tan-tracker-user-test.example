# Copy to .env.tan-tracker-user-test.local (gitignored). Synthetic user-test stand only.

PORT=3456
APP_ORIGIN=http://127.0.0.1:3456
NODE_ENV=development
PGSSLMODE=disable
TRUSTED_PROXIES=

TT_USER_TEST_ENV=true
DATABASE_URL=postgresql://tt56_user_test:CHANGE_ME@127.0.0.1:5432/tandoor_rf_tt56_user_test

TT_ATTACHMENTS_DIR=var/tt56-user-test/attachments
TT_USER_TEST_OTP_DIR=var/tt56-user-test/otp
TT_PHONE_VERIFICATION_PROVIDER=test
TT_OTP_PEPPER=change-me-tt56-user-test-pepper-min-16-chars

# Set only in shell when running seed (never commit):
# TT_USER_TEST_DEFAULT_PASSWORD=

TT56_USER_TEST_DB_USER=tt56_user_test
# TT56_USER_TEST_DB_PASSWORD=  # init-db.sh only

ONEC_FTP_ENABLED=false
BITRIX24_ENABLED=false
TANBOT_TELEGRAM_ENABLED=false
